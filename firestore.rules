rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow write only if sensitive fields are not modified or set by the client
      allow write: if request.auth != null && request.auth.uid == userId
        && (
          (resource == null && !request.resource.data.keys().hasAny(['plan', 'planExpiry', 'isTrial', 'paddleSubscriptionId', 'paddleTransactionId', 'graceUntil', 'graceReason'])) ||
          (resource != null && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'planExpiry', 'isTrial', 'paddleSubscriptionId', 'paddleTransactionId', 'graceUntil', 'graceReason']))
        );
      
      // VULN-08: Add explicit security rules for the auditLogs subcollection.
      match /auditLogs/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Only server-side admin writes allowed
      }
      
      match /trades/{tradeId} {
        // Read: only the owner
        allow read: if request.auth != null && request.auth.uid == userId;
        // Write: owner can write any valid trade doc
        // MT5 API writes happen via Firebase Admin SDK (bypasses these rules)
        allow create, update: if request.auth != null && request.auth.uid == userId
          && (request.resource.data.get('note', '') is string
              && request.resource.data.get('note', '').size() < 4000);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Secure journals
      match /journals/{journalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Secure broker accounts
      match /brokerAccounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Secure API keys (server-only write/read)
    match /apiKeys/{keyId} {
      allow read, write: if false;
    }

    // Secure PayPal Webhooks (server-only)
    match /paypalWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Secure PayPal Captures (server-only)
    match /paypalCaptures/{captureId} {
      allow read, write: if false;
    }
  }
}
